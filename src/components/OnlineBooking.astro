---
import Form from "./Form.astro";
import CarFromUp from "./ui/icons/CarFromUp.astro";
---

<div class="relative">
    <div
        class="absolute left-0 top-140 -z-10 h-24 bg-[#000000] w-full max-2xl:hidden overflow-hidden"
    >
        <div
            class="absolute top-[10%] left-0 w-full h-[3%] bg-yellow-300 overflow-hidden"
        >
        </div>
        <span class="absolute top-0 left-0 car-animation w-max">
            <CarFromUp />
        </span>
        <div class="absolute top-[90%] left-0 w-full h-[3%] bg-yellow-300">
        </div>
    </div>
</div>
<div
    class="relative -top-24 mx-auto w-max max-md:w-auto bg-[hsl(0,0%,1%)] my-10 flex mb-10"
>
    <div class="absolute left-0 top-0 bg-yellow-300 h-full w-4"></div>
    <div class="left-0 top-0 z-10 h-full px-10 py-12">
        <p class="text-yellow-300 mb-4">ONLINE BOOKING</p>
        <h2
            class="text-6xl max-lg:text-5xl max-sm:text-4xl max- font-extrabold text-slate-50 mb-16"
        >
            Confirm your booking now!
        </h2>
        <Form />
    </div>
</div>

<style>
    @keyframes moveCar {
        0% {
            left: 0%;
        }

        50% {
            left: 50%;
        }

        100% {
            left: 100%;
        }
    }

    .car-animation {
        animation: moveCar 13s linear infinite;
    }
</style>
