---
import Button from "./ui/Button.astro";
---

<div
    class="mx-auto max-w-[1440px] auto flex items-center gap-10 px-10 max-lg:flex-col mb-24"
>
    <div class="relative w-max max-sm:w-auto h-max">
        <img
            src="/assets/images/women.jpg"
            alt="Women"
            class="max-w-[500px] w-full"
        />
        <div
            class="absolute top-[-20%] left-[20%] w-[60%] -z-10 h-[140%] bg-yellow-300 -skew-x-12 animate-moveSideToSide"
        >
        </div>
        <img
            src="/assets/images/mark.webp"
            alt="Mark"
            class="absolute -top-12 -left-12 w-32"
        />
    </div>
    <div class="flex flex-col gap-4 mt-10">
        <p class="text-yellow-100">Welcome to Salem Taxi</p>
        <h1 class="text-6xl max-2xl:text-5xl font-bold mb-4">
            We Provide <span class="text-yellow-300">Trusted</span> Cab Services
        </h1>
        <div class="font-light mb-4 max-w-[800px]">
            <p>
                We consistently tackle tasks of all levels of complexity,
                ranging from simple solutions to intricate and multifaceted
                projects.
            </p>
            <br />

            <p>
                Our team is dedicated to delivering high-quality results, backed
                by long-term guarantees that ensure our clients' peace of mind.
            </p>
            <br />

            <p>
                We take pride in our continuous pursuit of excellence by
                regularly embracing and mastering emerging technologies, staying
                ahead of industry trends.
            </p>
            <br />
            <p>
                This commitment to innovation, paired with our expertise,
                enables us to deliver cutting-edge solutions while maintaining a
                focus on reliability and long-term success.
            </p>
        </div>
        <div
            class="relative max-w-[500px] pl-5 border-l-4 border-yellow-300 mb-8"
        >
            <p class="font-bold">
                Our portfolio includes dozens of successfully completed projects
                of houses of different storeys,
            </p>
        </div>
        <a href="/contact">
            <Button text="Book Taxi" />
        </a>
    </div>
</div>

<style>
    @keyframes moveSideToSide {
        0% {
            transform: translateX(0);
        }
        50% {
            transform: translateX(20px);
        }
        100% {
            transform: translateX(0);
        }
    }

    .animate-moveSideToSide {
        animation: moveSideToSide 5s ease-in-out infinite; /* Duración de 2 segundos y repetición infinita */
    }
</style>
