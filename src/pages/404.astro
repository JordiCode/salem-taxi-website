---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Salem Taxi LLC - 404 - PAGE NOT FOUND">
    <div class="flex flex-col items-center max-w-[1440px] mx-auto px-10 py-24">
        <div class="py-24 text-center">
            <p class="font-bold text-8xl mb-2 max-sm:text-6xl">
                404 - PAGE NOT FOUND
            </p>
            <p class="mb-16 text-zinc-400">
                The page you are looking for does not exist or has been moved.
            </p>
            <a href="/" class="text-yellow-500 font-semibold"
                >Volver a la página de inicio</a
            >
        </div>
    </div>
</Layout>
